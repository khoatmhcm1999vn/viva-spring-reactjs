# Copy file nay thanh .env roi dien gia tri that. File .env bi gitignore.
#
#   cp .env.example .env
#
# Docker Compose tu doc .env o thu muc goc project, nen "docker compose up" se nhan
# duoc cac bien nay ma khong can truyen gi them.
#
# Hai bien DB_PASSWORD va JWT_SECRET_SALT la BAT BUOC: compose dung cu phap ${VAR:?}
# nen thieu la bao loi ngay thay vi khoi dong voi cau hinh thieu.

# --- Bat buoc ---
DB_PASSWORD=
# Ai co salt nay la tu ky duoc JWT hop le cho bat ky user nao, ke ca ADMIN.
# Prod phai dung gia tri rieng, dai va ngau nhien.
JWT_SECRET_SALT=

# --- Cong tren may host ---
# Mac dinh tranh cong 5432 va 8900 vi mot stack khac tren may dang giu chung.
DB_PORT=5433
BACKEND_PORT=8091
FRONTEND_PORT=8081
ADMINER_PORT=8901

# --- Gioi han RAM moi container ---
# Mac dinh vua cho mot VM ~3.3 GB. Gioi han cho backend la bat buoc ve mat y nghia:
# JVM dat -XX:MaxRAMPercentage=75 va "75%" duoc tinh theo gioi han cgroup, nen neu
# bo trong thi no lay 75% RAM ca may.
DB_MEM_LIMIT=640m
BACKEND_MEM_LIMIT=1200m
FRONTEND_MEM_LIMIT=128m

# --- Tag image ---
# Co "image" trong compose nen co the build o may khac roi chuyen sang bang
# "docker save | docker load", khong can build tren server.
BACKEND_IMAGE=vivacon-backend:latest
FRONTEND_IMAGE=vivacon-frontend:latest

# --- Origin duoc phep ket noi WebSocket ---
# Phai khop voi dia chi thuc te ma nguoi dung mo frontend, neu khong chat va
# notification se chet im lang: trang van tai, chi rieng socket khong ket noi.
FRONTEND_ALLOWED_ORIGINS=http://localhost:8081

# --- Profile ---
# prod la mac dinh va nen giu nguyen. Profile dev bat vivacon.verification.bypass,
# tuc bo qua xac thuc email, khong dung cho moi truong giong deploy.
SPRING_PROFILES_ACTIVE=prod

# --- Email qua Microsoft Graph (tuy chon) ---
# De trong thi app van chay, chi khong gui duoc mail. Xem huong dan lay refresh token
# trong config/application-dev.yml.
MAIL_FROM_ADDRESS=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REFRESH_TOKEN=

# --- Luu tru anh (tuy chon) ---
# De trong thi app van boot, chi endpoint upload attachment se loi khi goi.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
