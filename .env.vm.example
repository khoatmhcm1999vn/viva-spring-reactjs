# Khuon mau .env cho VM Ubuntu khi backend dung Supabase (docker-compose.supabase.yml).
#
# Copy thanh .env TREN VM (cung thu muc voi docker-compose.yml), dien gia tri, roi:
#   chmod 600 .env
#   scripts/deploy/vm-backend-up.sh --check-only
#
# KHONG commit file .env. Khong dien gia tri that vao file .example nay.
# Ghi chu dat tren dong rieng: compose co the coi " #" o cuoi dong la mot phan gia tri.
# Neu mot gia tri chua ky tu $, boc no trong nhay don: DB_PASSWORD='abc$def'

# ---- Supabase (Dashboard -> Connect -> Session pooler, cong 5432, KHONG dung 6543)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
# Mat khau database Supabase. Dashboard khong cho xem lai; mat thi phai Reset.
DB_PASSWORD=

# ---- JWT. Giu gia tri cu neu con. Sinh moi: openssl rand -base64 48
JWT_SECRET_SALT=

# ---- Origin duoc goi API va mo WebSocket. Phan cach bang dau phay.
# Hostname tunnel: docker logs vivacon-cloudflared 2>&1 | grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' | tail -1
FRONTEND_ALLOWED_ORIGINS=http://192.168.221.128,https://*.vercel.app,https://<tunnel-host>

# ---- Cong va image
FRONTEND_PORT=80
SPRING_PROFILES_ACTIVE=prod
# vm-backend-up.sh tu cap nhat hai dong duoi moi lan deploy / rollback.
BACKEND_IMAGE=vivacon-backend:latest
PREVIOUS_BACKEND_IMAGE=
FRONTEND_IMAGE=vivacon-frontend:latest

# ---- Tunnel. Rong = quick tunnel (hostname doi moi lan recreate cloudflared).
TUNNEL_COMMAND=
TUNNEL_TOKEN=

# ---- Dich vu ngoai. De trong thi app van chay: upload anh / gui mail bi tat.
MAIL_FROM_ADDRESS=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REFRESH_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Gioi han RAM (VM ~3.3 GB)
DB_MEM_LIMIT=640m
BACKEND_MEM_LIMIT=1200m
FRONTEND_MEM_LIMIT=128m
TUNNEL_MEM_LIMIT=128m
