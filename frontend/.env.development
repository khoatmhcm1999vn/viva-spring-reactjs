REACT_APP_API_URL=http://localhost:8090/api
REACT_APP_SOCKET_URL=http://localhost:8090/ws

# File nay duoc git track (repo public): KHONG dien secret o day.
# Gia tri that dat trong .env.development.local (da gitignore), CRA tu nap file do.
# Luu y: moi bien REACT_APP_* deu bi nhung vao bundle JS, nguoi dung xem duoc.
# De dang comment, KHONG de "KEY=" rong: start:dev nap file nay bang env-cmd truoc,
# CRA khong ghi de bien da ton tai (ke ca rong) nen gia tri trong .local se bi bo qua.
# REACT_APP_DETECT_IMAGES_SECRET=
REACT_APP_DETECT_IMAGES_USER=178066551
REACT_APP_DETECT_IMAGES_API_URL=https://api.sightengine.com/1.0/check.json
# Bo qua kiem duyet anh SightEngine khi tao bai (demo local). Dat false de bat lai.
REACT_APP_SKIP_IMAGE_MODERATION=true

# REACT_APP_GOOGLE_MAP_KEY=  (dat trong .env.development.local)
REACT_APP_GOOGLE_MAP_API_URL=https://maps.googleapis.com/maps/api

NODE_ENV=development
