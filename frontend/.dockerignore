# node_modules o may dev nang hon 1 GB va duoc cai lai trong image, nen khong can
# gui sang daemon. Gui sang con nguy hiem: binary native build cho Windows se de len
# ban cai trong container Linux.
node_modules
build

# Lock file sinh tu may dev. Du an co y gitignore no, va image luon cai moi,
# nen khong mang vao de tranh lech voi ket qua cai trong container.
package-lock.json

# File moi truong cua may ca nhan
.env.local
.env.*.local

# Khong can cho viec build
Dockerfile
.dockerignore
README.md
