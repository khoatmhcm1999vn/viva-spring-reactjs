# Khong co file nay thi docker gui toan bo build context cho daemon, tuc hon 1 GB
# chi rieng frontend/node_modules. Build backend khong can gi trong so do.

# Phu thuoc va ket qua build cua frontend (hon 1 GB)
frontend/node_modules
frontend/build
frontend/.env.local
frontend/.env.*.local

# Ket qua build cua backend: image tu build lai tu source, khong dung target san co
target

# Lich su git (gan 35 MB) va cau hinh IDE
.git
.gitignore
.idea
.vscode

# Secret cua may ca nhan. TUYET DOI khong dua vao image:
# credential that duoc truyen vao luc chay bang bien moi truong.
config

# Log, tai lieu, va nhung thu chi dung o may dev
logs
*.log
postman_collection
mock_data
container
docker-compose.yml
Dockerfile
.dockerignore
README.md
HELP.md

# Steering va cau hinh cua Kiro
.kiro
