        <mxCell id="t" value="&lt;b&gt;ORDERS — logical relationships / snapshot fields&lt;/b&gt;&lt;br&gt;Gray tables repeat Catalog entities. Crow’s-foot shows collection relationships; optional/unique constraints below refine cardinality." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1920" height="80" as="geometry" />
