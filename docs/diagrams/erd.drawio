          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Consistency&lt;/b&gt;&lt;br&gt;One transaction creates order + items + modifiers + payment + initial history + idempotency mapping.&lt;br&gt;Unique(user_id,key) and request hash protect retries. Unique quote_id prevents double checkout.&lt;br&gt;Money and recipient/catalog snapshots remain unchanged after menu/profile edits.&lt;br&gt;CAS version guards status and payment updates; all changes are authorized server-side.&lt;br&gt;Payment attempts 1:N future; MVP enforces one PAY_AT_COUNTER record. See data-model.md for constraints." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="1270" width="1880" height="190" as="geometry" />
        </mxCell>
