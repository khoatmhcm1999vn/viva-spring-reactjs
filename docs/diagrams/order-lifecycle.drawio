        <mxCell id="payment" value="&lt;b&gt;PAYMENT: UNPAID → PAID&lt;/b&gt;&lt;br&gt;Staff collects at READY, records actor + paid_at.&lt;br&gt;Race guarded independently by payment.version.&lt;br&gt;Completing an unpaid order is forbidden." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#64748b;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="460" width="710" height="130" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Policies&lt;/b&gt;&lt;br&gt;History written atomically with every state update; terminal states have no outgoing transitions.&lt;br&gt;Online payment/refund and delivery are deferred. Future delivery may add READY → OUT_FOR_DELIVERY → COMPLETED after policies/tests are defined.&lt;br&gt;No transition to a future state is enabled merely because it appears in design documentation." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1410" height="150" as="geometry" />
        </mxCell>
