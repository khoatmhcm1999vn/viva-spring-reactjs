        <mxCell id="t" value="&lt;b&gt;PICKUP ORDER LIFECYCLE — separate payment state&lt;/b&gt;&lt;br&gt;MVP: PAY_AT_COUNTER. All mutations guarded by role/store + expectedVersion." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1">
