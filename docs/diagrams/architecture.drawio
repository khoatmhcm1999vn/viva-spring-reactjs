        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Supabase PostgreSQL&lt;/b&gt;&lt;br&gt;Business tables + migrations&lt;br&gt;Direct IPv6 / session pooler IPv4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#64748b;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
