        </mxCell>
        <mxCell id="api" value="&lt;b&gt;VM: Docker API container&lt;/b&gt;&lt;br&gt;NestJS REST /v1 + Prisma&lt;br&gt;RBAC, price, transactions, history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="170" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="&lt;b&gt;VM: HTTPS reverse proxy&lt;/b&gt;&lt;br&gt;Caddy or Nginx&lt;br&gt;Only API upstream exposed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="380" width="310" height="100" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;Email/password, access JWT&lt;br&gt;Backend verifies JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#64748b;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
