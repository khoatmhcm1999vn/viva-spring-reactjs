  <diagram id="Architecture" name="Architecture">
    <mxGraphModel dx="1500" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;COFFEE ORDER — MVP deployment architecture&lt;/b&gt;&lt;br&gt;Design target; infrastructure not yet provisioned" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1350" height="65" as="geometry" />
        </mxCell>
        <mxCell id="users" value="&lt;b&gt;Customers / Staff / Admin&lt;/b&gt;&lt;br&gt;Browser, mobile-first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#64748b;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="web" value="&lt;b&gt;Vercel: apps/web&lt;/b&gt;&lt;br&gt;Next.js / React / TypeScript&lt;br&gt;Query, Zustand cart, forms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
