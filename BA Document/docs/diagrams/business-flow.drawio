        <mxCell id="bfP3" value="3. Đăng bài: ảnh + chú thích + mức riêng tư" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="laneB">
