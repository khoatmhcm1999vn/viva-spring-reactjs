        <mxCell id="rgU1" value="Điền biểu mẫu: email, tên đăng nhập, họ tên, mật khẩu, nhập lại mật khẩu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="rgL1">
