        <mxCell id="bfTitle" value="VIVACON — TỔNG QUAN LUỒNG NGHIỆP VỤ CHÍNH&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Chia làn theo vai trò. Mọi bước đều đối chiếu được với mã nguồn; các điểm chưa rõ nằm ở trang chi tiết.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1960" height="50" as="geometry" />
        </mxCell>

