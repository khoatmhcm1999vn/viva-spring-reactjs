        <mxCell id="bfP2" value="2. Hoàn thiện hồ sơ, theo dõi người khác" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="laneB">
