        <mxCell id="bfLg7" value="Đường LIỀN ĐẬM = luồng nghiệp vụ chính&lt;br&gt;Đường NÉT ĐỨT = ghi/đọc dữ liệu, ghi chú&lt;br&gt;Nhãn trên đường nối = điều kiện chuyển bước" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="bfLegend">
