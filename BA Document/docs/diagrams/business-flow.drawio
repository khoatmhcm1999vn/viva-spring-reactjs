          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rgEl" value="Không (prod)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=10;fontStyle=1;" edge="1" parent="1" source="rgB6" target="rgB7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rgEm" value="Có (dev): tài khoản ACTIVE ngay,&#10;mã chỉ ghi vào log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="rgB6" target="rgB9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rgEn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rgB7" target="rgX1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rgEo" value="email chứa mã" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d79b00;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=10;" edge="1" parent="1" source="rgX1" target="rgU2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rgEp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rgU2" target="rgF3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rgEq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rgF3" target="rgB9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rgEr" value="trả JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=10;" edge="1" parent="1" source="rgB9" target="rgEnd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rgEs" value="sửa lại và gửi lần nữa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=0;entryY=1;fontSize=10;" edge="1" parent="1" source="rgB8" target="rgU1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rgRules" value="&lt;b&gt;QUY TẮC ĐƯỢC XÁC NHẬN TỪ MÃ NGUỒN&lt;/b&gt;" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=0;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="900" height="290" as="geometry" />
        </mxCell>
        <mxCell id="rgR1" value="&lt;b&gt;Tên đăng nhập&lt;/b&gt;: tối thiểu 3 ký tự, chỉ chữ, số và . _ -&lt;br&gt;Không có giới hạn trên; kiểm tra trùng không phân biệt hoa thường." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;spacingLeft=6;spacingTop=4;" vertex="1" parent="rgRules">
          <mxGeometry x="15" y="40" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="rgR2" value="&lt;b&gt;Mật khẩu&lt;/b&gt;: 8–30 ký tự, bắt buộc có chữ số, chữ thường, chữ hoa và ký tự đặc biệt. Trường nhập lại phải khớp." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;spacingLeft=6;spacingTop=4;" vertex="1" parent="rgRules">
          <mxGeometry x="450" y="40" width="430" height="55" as="geometry" />
        </mxCell>
        <mxCell id="rgR3" value="&lt;b&gt;Họ tên&lt;/b&gt;: 1–50 ký tự. &lt;b&gt;Email&lt;/b&gt;: đúng định dạng và chưa tồn tại trong hệ thống." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;spacingLeft=6;spacingTop=4;" vertex="1" parent="rgRules">
          <mxGeometry x="15" y="105" width="420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="rgR4" value="&lt;b&gt;Mã kích hoạt&lt;/b&gt;: 6 chữ số, hạn dùng 10 phút, lưu trực tiếp trên bản ghi tài khoản." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;spacingLeft=6;spacingTop=4;" vertex="1" parent="rgRules">
          <mxGeometry x="450" y="105" width="430" height="45" as="geometry" />
        </mxCell>
        <mxCell id="rgR5" value="&lt;b&gt;Vai trò khi đăng ký&lt;/b&gt;: luôn là USER. Không tìm thấy luồng API nào nâng quyền lên ADMIN hoặc SUPER_ADMIN — việc đó phải làm trực tiếp trong cơ sở dữ liệu." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;spacingLeft=6;spacingTop=4;" vertex="1" parent="rgRules">
          <mxGeometry x="15" y="160" width="865" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rgR6" value="&lt;b&gt;Đăng nhập khi chưa kích hoạt&lt;/b&gt;: trả HTTP 403 kèm mã nghiệp vụ 1002 và tự động gửi lại mã xác thực. Mã 1001 = tài khoản bị khoá, 1003 = thiết bị lạ cần xác minh." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;spacingLeft=6;spacingTop=4;" vertex="1" parent="rgRules">
          <mxGeometry x="15" y="215" width="865" height="60" as="geometry" />
        </mxCell>

        <mxCell id="rgGaps" value="&lt;b&gt;KHOẢNG TRỐNG VÀ RỦI RO&lt;/b&gt; (hành vi thực tế của mã nguồn, không phải thiết kế mong đợi)" style="swimlane;html=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=0;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="820" width="880" height="250" as="geometry" />
        </mxCell>
        <mxCell id="rgG1" value="&lt;b&gt;1.&lt;/b&gt; Mã kích hoạt sinh bằng bộ sinh số giả ngẫu nhiên thông thường, không phải bộ sinh dành cho mục đích mật mã." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;spacingLeft=6;spacingTop=4;" vertex="1" parent="rgGaps">
          <mxGeometry x="15" y="40" width="850" height="35" as="geometry" />
        </mxCell>
        <mxCell id="rgG2" value="&lt;b&gt;2.&lt;/b&gt; Mã không bị xoá sau khi dùng thành công, nên vẫn còn hiệu lực cho tới khi hết hạn hoặc bị ghi đè." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;spacingLeft=6;spacingTop=4;" vertex="1" parent="rgGaps">
          <mxGeometry x="15" y="80" width="850" height="35" as="geometry" />
        </mxCell>
        <mxCell id="rgG3" value="&lt;b&gt;3.&lt;/b&gt; Endpoint kiểm tra trùng là công khai và trả về thông tin tài khoản khi tìm thấy, nên cho phép dò xem một tên đăng nhập hoặc email có tồn tại hay không." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;spacingLeft=6;spacingTop=4;" vertex="1" parent="rgGaps">
          <mxGeometry x="15" y="120" width="850" height="45" as="geometry" />
        </mxCell>
        <mxCell id="rgG4" value="&lt;b&gt;4.&lt;/b&gt; Tài khoản quản trị tạo qua API quản trị KHÔNG được sinh bộ thiết lập mặc định, nên mọi chỗ đọc thiết lập của tài khoản đó sẽ báo lỗi không tìm thấy bản ghi." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;spacingLeft=6;spacingTop=4;" vertex="1" parent="rgGaps">
          <mxGeometry x="15" y="170" width="850" height="45" as="geometry" />
        </mxCell>
        <mxCell id="rgG5" value="&lt;b&gt;5.&lt;/b&gt; Cờ bỏ qua xác thực email đang bật ở cấu hình phát triển. Không được bật trên môi trường triển khai." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;spacingLeft=6;spacingTop=4;" vertex="1" parent="rgGaps">
          <mxGeometry x="15" y="220" width="850" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

