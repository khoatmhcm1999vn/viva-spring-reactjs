          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mdEe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mdA1" target="mdA2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mdEf" value="DUYỆT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;fontStyle=1;" edge="1" parent="1" source="mdA2" target="mdS2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mdEg" value="TỪ CHỐI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b85450;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=10;fontStyle=1;" edge="1" parent="1" source="mdA2" target="mdS4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mdEh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d6b656;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mdS2" target="mdS2a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mdEi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d6b656;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mdS2a" target="mdS2b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mdEj" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d6b656;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mdS2b" target="mdS2c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mdEk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mdS2" target="mdS3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mdEl" value="thông báo cho người tố cáo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=10;" edge="1" parent="1" source="mdS3" target="mdU3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mdEm" value="thông báo cho người bị xử lý" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;" edge="1" parent="1" source="mdS3" target="mdV1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="mdGaps" value="&lt;b&gt;KHOẢNG TRỐNG VÀ RỦI RO&lt;/b&gt; — đây là hành vi hiện tại của mã nguồn, cần quyết định xử lý" style="swimlane;html=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="1700" height="280" as="geometry" />
        </mxCell>
        <mxCell id="mdGa" value="&lt;b&gt;R1 — Duyệt và từ chối không phân biệt được trong dữ liệu.&lt;/b&gt; Không có cột trạng thái cho báo cáo; cả hai quyết định đều chỉ đặt active = false. Khác biệt duy nhất là nhánh duyệt có ghi người xử lý, nhưng đó là dấu hiệu gián tiếp và không đáng tin. Nếu nghiệp vụ cần ba trạng thái CHỜ / ĐÃ DUYỆT / ĐÃ TỪ CHỐI thì phải bổ sung vào mô hình dữ liệu." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;spacingLeft=6;spacingTop=4;" vertex="1" parent="mdGaps">
          <mxGeometry x="15" y="40" width="820" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mdGb" value="&lt;b&gt;R2 — Thao tác duyệt và từ chối KHÔNG giới hạn cho quản trị viên.&lt;/b&gt; Sáu endpoint duyệt/từ chối nằm ngoài tiền tố dành cho quản trị, nên theo cấu hình phân quyền hiện tại, bất kỳ người dùng đã đăng nhập đều gọi được. Hệ quả: một người dùng thường có thể khoá tài khoản người khác, ẩn bài đăng và ẩn bình luận của người khác." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;spacingLeft=6;spacingTop=4;" vertex="1" parent="mdGaps">
          <mxGeometry x="850" y="40" width="835" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mdGc" value="&lt;b&gt;R3 — Từ chối báo cáo không thông báo cho người tố cáo.&lt;/b&gt; Nhánh từ chối không phát sự kiện nào, nên người gửi báo cáo không biết kết quả." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;spacingLeft=6;spacingTop=4;" vertex="1" parent="mdGaps">
          <mxGeometry x="15" y="130" width="820" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mdGd" value="&lt;b&gt;R4 — Không có cơ chế chống lạm dụng.&lt;/b&gt; Không chặn tự tố cáo, không chặn tố cáo trùng, không giới hạn số lần." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;spacingLeft=6;spacingTop=4;" vertex="1" parent="mdGaps">
          <mxGeometry x="850" y="130" width="835" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mdGe" value="&lt;b&gt;R5 — Không tìm thấy luồng gỡ khoá tài khoản.&lt;/b&gt; Khi một tài khoản đã bị đặt trạng thái BANNED, không có endpoint nào đưa nó trở lại ACTIVE." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;spacingLeft=6;spacingTop=4;" vertex="1" parent="mdGaps">
          <mxGeometry x="15" y="190" width="820" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mdGf" value="&lt;b&gt;R6 — Điều kiện gửi email kết quả đọc sai thiết lập.&lt;/b&gt; Cả hai thông báo (cho người tố cáo và cho người bị xử lý) đều kiểm tra thiết lập email của &lt;i&gt;người tố cáo&lt;/i&gt;." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;spacingLeft=6;spacingTop=4;" vertex="1" parent="mdGaps">
          <mxGeometry x="850" y="190" width="835" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mdGg" value="&lt;b&gt;Lưu ý về tên gọi:&lt;/b&gt; bảng &quot;report_template&quot; KHÔNG phải danh mục mẫu lý do tố cáo. Nó là bảng cha của ba loại báo cáo theo chiến lược kế thừa JOINED, chứa nội dung tố cáo và nhóm vi phạm." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=6;" vertex="1" parent="mdGaps">
          <mxGeometry x="15" y="248" width="1670" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
