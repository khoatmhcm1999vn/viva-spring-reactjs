          <mxGeometry x="500" y="100" width="320" height="800" as="geometry" />
        </mxCell>
        <mxCell id="s3cApi" value="SPRING BOOT 2.5 — VÀO &amp;amp; BẢO MẬT" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fontStyle=1;fontSize=12;collapsible=0;fillColor=#B1DDF0;strokeColor=#10739E;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;" vertex="1" parent="1">
