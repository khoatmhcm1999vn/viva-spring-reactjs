        <mxCell id="s4e9" value="dev only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;strokeWidth=1.5;dashed=1;dashPattern=2 4;endArrow=block;endFill=1;fontColor=#4A148C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4643;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4Adminer" target="s4Db">
