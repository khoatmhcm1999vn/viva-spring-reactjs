        <mxCell id="s3cData" value="LƯU TRỮ" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fontStyle=1;fontSize=12;collapsible=0;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1840" y="100" width="340" height="800" as="geometry" />
        </mxCell>
        <mxCell id="s3cExt" value="DỊCH VỤ NGOÀI — GỌI TỪ SERVER" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fontStyle=1;fontSize=12;collapsible=0;fillColor=#E1D5E7;strokeColor=#9673A6;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="2240" y="100" width="320" height="800" as="geometry" />
        </mxCell>
        <mxCell id="s3Routes" value="&lt;b&gt;routes/routes.js&lt;/b&gt; — RouterList + PrivateRoute&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nhánh khách / user / admin theo roles trong JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;" vertex="1" parent="s3cBrowser">
          <mxGeometry x="40" y="50" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3Pages" value="&lt;b&gt;components/pages/*&lt;/b&gt;, dashboard/, common/&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PostsListPage, ChatPage, SettingPage → LoginActivityPage, Dashboard, CreatePostModal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;" vertex="1" parent="s3cBrowser">
          <mxGeometry x="40" y="140" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s3State" value="&lt;b&gt;App.js contexts + globalSocketState&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Context + useReducer. redux có trong package.json nhưng không dùng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;" vertex="1" parent="s3cBrowser">
          <mxGeometry x="40" y="250" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3Api" value="&lt;b&gt;api/*Service.js (12) → api/axiosConfig.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;baseURL ${REACT_APP_API_URL}/v1, Bearer từ cookie jwt-token; 401 → POST /refresh-token rồi gửi lại&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;" vertex="1" parent="s3cBrowser">
          <mxGeometry x="40" y="350" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s3Sock" value="&lt;b&gt;hooks/useSocket.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SockJS + stompjs 2.3.3, header WS-Authorization. SUB /topic/account/online, /user/{u}/notification, /conversation/{id}/message. SEND /app/chat …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;" vertex="1" parent="s3cBrowser">
          <mxGeometry x="40" y="460" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s3Cookie" value="&lt;b&gt;utils/cookie.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;js-cookie: jwt-token, refresh-token (SameSite=Lax)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;" vertex="1" parent="s3cBrowser">
          <mxGeometry x="40" y="580" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3Nginx" value="&lt;b&gt;nginx 1.27&lt;/b&gt; — frontend/nginx.conf.template&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;location / → index.html (SPA)&lt;br&gt;/api/ → backend_upstream (${BACKEND_ORIGIN})&lt;br&gt;/ws/ → backend_upstream + Upgrade/Connection, timeout 3600 s&lt;br&gt;/healthz → 200&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="s3cEdge">
          <mxGeometry x="20" y="320" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="s3Dev" value="&lt;b&gt;Chạy dev&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CRA :3000 gọi thẳng API :8090 (frontend/.env.development) — không qua nginx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#1A1A1A;dashed=1;" vertex="1" parent="s3cEdge">
