<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="sa-deploy" name="1. Tổng quan triển khai">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="saTitle" value="VIVACON — KIẾN TRÚC TRIỂN KHAI&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Ba tầng nằm trên ba nhà cung cấp khác nhau, nối với nhau bằng hai đường HTTPS công khai&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1860" height="50" as="geometry" />
        </mxCell>

        <mxCell id="saGbrowser" value="THIẾT BỊ NGƯỜI DÙNG" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=1;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="saBrowser" value="&lt;b&gt;Trình duyệt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;React 17 SPA, gói tài nguyên ~4,2 MB&lt;br&gt;JWT lưu trong cookie của origin frontend&lt;br&gt;Mọi request mang header Authorization&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="290" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="saGvercel" value="VERCEL — CDN TOÀN CẦU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=1;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="saVercel" value="&lt;b&gt;Hosting tĩnh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Thư mục gốc: frontend/&lt;br&gt;Mọi đường dẫn không khớp tệp → index.html&lt;br&gt;Không chạy mã phía server, không giữ WebSocket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="140" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="saGcf" value="CLOUDFLARE — BIÊN TOÀN CẦU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=1;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="saCf" value="&lt;b&gt;Điểm vào HTTPS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Chứng chỉ TLS hợp lệ do Cloudflare cấp&lt;br&gt;Chuyển tiếp được cả WebSocket&lt;br&gt;Hostname tạm: đổi mỗi lần khởi động lại&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="340" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="saGsight" value="DỊCH VỤ GỌI TỪ TRÌNH DUYỆT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe9e7;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=1;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="saSight" value="&lt;b&gt;SightEngine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Sàng lọc ảnh trước khi tải lên.&lt;br&gt;&lt;b&gt;Chỉ chạy ở phía trình duyệt&lt;/b&gt; nên là trợ giúp trải nghiệm, KHÔNG phải chốt kiểm soát: backend không kiểm duyệt lại.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="85" y="560" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="saGvm" value="MÁY ẢO UBUNTU — DOCKER COMPOSE (chỉ container frontend mở cổng ra ngoài)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=1;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="520" height="600" as="geometry" />
        </mxCell>
        <mxCell id="saCfd" value="&lt;b&gt;cloudflared&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Mở đường hầm từ trong ra. Không cần IP tĩnh, không cần mở cổng trên router.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="150" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="saNginx" value="&lt;b&gt;nginx&lt;/b&gt; — cổng 80&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Phục vụ tệp tĩnh; chuyển tiếp /api/ và /ws/ sang backend; mọi đường dẫn khác trả index.html.&lt;br&gt;Giữ header Upgrade để SockJS bắt tay được.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="280" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="saBe" value="&lt;b&gt;Spring Boot&lt;/b&gt; — cổng 8080, cấu hình prod&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;REST API /api/v1/** · Broker STOMP tại /ws&lt;br&gt;Xác thực JWT không phiên (stateless)&lt;br&gt;Danh sách origin được phép điều khiển CẢ CORS và bắt tay WebSocket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="430" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="saGeo" value="&lt;b&gt;GeoLite2-City.mmdb&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Tệp tra cứu vị trí theo IP, nằm ngay trong thư mục làm việc của container&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1000" y="580" width="440" height="80" as="geometry" />
        </mxCell>

        <mxCell id="saGsb" value="SUPABASE — ap-south-1 (Mumbai)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=1;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="960" y="750" width="520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="saPool" value="&lt;b&gt;Session pooler&lt;/b&gt; — cổng 5432&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Phải dùng chế độ session, không dùng chế độ transaction: gộp phiên sẽ làm vỡ prepared statement của Hibernate.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="790" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="saPg" value="&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;19 bảng nghiệp vụ · 14 hàm lưu trữ dùng cho thống kê và gợi ý&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="890" width="440" height="80" as="geometry" />
        </mxCell>

        <mxCell id="saGext" value="DỊCH VỤ GỌI TỪ BACKEND" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=1;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1580" y="300" width="320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="saCloud" value="&lt;b&gt;Cloudinary / AWS S3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Lưu ảnh của bài đăng và ảnh đại diện&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1610" y="345" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="saGraph" value="&lt;b&gt;Microsoft Graph&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Gửi email mã xác thực và kết quả kiểm duyệt. Không dùng SMTP.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1610" y="450" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="saE1" value="HTML, JS, CSS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.25;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="saBrowser" target="saVercel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saE2" value="XHR /api/v1/**&#10;và SockJS /ws" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#d6b656;exitX=1;exitY=0.75;entryX=0;entryY=0.5;fontSize=10;fontStyle=1;" edge="1" parent="1" source="saBrowser" target="saCf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saE3" value="tải ảnh lên để sàng lọc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;" edge="1" parent="1" source="saBrowser" target="saSight">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saE4" value="đường hầm ra ngoài" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#d6b656;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="saCf" target="saCfd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saE5" value="http://frontend:80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;" edge="1" parent="1" source="saCfd" target="saNginx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saE6" value="/api/ và /ws/ → backend:8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;" edge="1" parent="1" source="saNginx" target="saBe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saE7" value="đọc khi đăng nhập" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;exitX=0.25;exitY=1;entryX=0.25;entryY=0;fontSize=10;" edge="1" parent="1" source="saBe" target="saGeo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saE8" value="JDBC qua TLS 1.3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#82b366;exitX=0.75;exitY=1;entryX=0.75;entryY=0;fontSize=10;fontStyle=1;" edge="1" parent="1" source="saBe" target="saPool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saE9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="saPool" target="saPg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saE10" value="tải ảnh lên" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d79b00;exitX=1;exitY=0.25;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="saBe" target="saCloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saE11" value="gửi email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d79b00;exitX=1;exitY=0.75;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="saBe" target="saGraph">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saE12" value="đẩy thông báo và tin nhắn realtime&#10;(WebSocket giữ kết nối hai chiều)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;dashed=1;exitX=0;exitY=0.75;entryX=0.5;entryY=1;fontSize=10;" edge="1" parent="1" source="saBe" target="saBrowser">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="500" />
              <mxPoint x="900" y="720" />
              <mxPoint x="210" y="720" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="saWhy" value="&lt;b&gt;VÌ SAO ĐƯỜNG ĐI PHẢI VÒNG NHƯ VẬY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cách hiển nhiên là để Vercel chuyển tiếp /api về backend. Cách đó không khả thi vì ba lý do độc lập:&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Trang phục vụ qua HTTPS không gọi được một địa chỉ HTTP nội bộ — trình duyệt chặn vì nội dung lẫn lộn giao thức.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Biên của Vercel cũng không với tới địa chỉ nội bộ của máy ảo, nên chuyển tiếp ở phía Vercel không giải quyết gì.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; &lt;b&gt;Vercel không giữ được kết nối WebSocket.&lt;/b&gt; Đường /ws không bao giờ chuyển tiếp qua Vercel được, nên tính năng chat và thông báo buộc phải nối thẳng vào backend.&lt;br&gt;&lt;br&gt;Ba lý do, một kết luận: backend cần hostname HTTPS công khai riêng. Một địa chỉ nội bộ sau NAT thì không xin được chứng chỉ, nên phải dùng đường hầm.&lt;br&gt;&lt;br&gt;&lt;i&gt;Đường hầm trỏ vào nginx, không trỏ thẳng vào backend — nhờ vậy một hostname duy nhất phục vụ được cả tệp tĩnh, API và WebSocket.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#666666;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="860" height="260" as="geometry" />
        </mxCell>

        <mxCell id="saLegend" value="CHÚ GIẢI" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="1010" width="1840" height="130" as="geometry" />
        </mxCell>
        <mxCell id="saLg1" value="Thành phần phía người dùng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="saLegend">
          <mxGeometry x="20" y="45" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="saLg2" value="Thành phần do ta vận hành" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="saLegend">
          <mxGeometry x="240" y="45" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="saLg3" value="Hạ tầng / lưu trữ được quản lý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="saLegend">
          <mxGeometry x="460" y="45" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="saLg4" value="Dịch vụ bên thứ ba" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="saLegend">
          <mxGeometry x="680" y="45" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="saLg5" value="Điểm cần chú ý về rủi ro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="saLegend">
          <mxGeometry x="900" y="45" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="saLg6" value="Khung nét đứt = một nơi triển khai (ranh giới hạ tầng)&#10;Đường đậm = đường đi chính của một request nghiệp vụ&#10;Đường nét đứt = luồng phụ, đọc tệp hoặc đẩy dữ liệu về client" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="saLegend">
          <mxGeometry x="1120" y="40" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="saLg7" value="&lt;b&gt;Ghi nhận đo được:&lt;/b&gt; mỗi lượt truy vấn cơ sở dữ liệu từ máy ảo sang Supabase mất khoảng 105 ms vì khoảng cách địa lý. Endpoint truy vấn một lần thì bình thường; endpoint truy vấn theo từng phần tử của danh sách sẽ chậm rõ rệt." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;" vertex="1" parent="saLegend">
          <mxGeometry x="20" y="90" width="1800" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="sa-components" name="2. Chi tiết thành phần">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="scTitle" value="PHÂN LỚP THÀNH PHẦN — GIAO DIỆN VÀ BACKEND&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Backend phân lớp theo mối quan tâm kỹ thuật, không theo tính năng&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1780" height="50" as="geometry" />
        </mxCell>

        <mxCell id="scFe" value="GIAO DIỆN — React 17 (Create React App)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f7ff;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=center;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="520" height="700" as="geometry" />
        </mxCell>
        <mxCell id="scFe1" value="&lt;b&gt;components/pages/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Trang theo tuyến đường: đăng nhập, hồ sơ, newsfeed, chat, dashboard quản trị&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="150" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="scFe2" value="&lt;b&gt;components/common/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Thành phần dùng lại. Một thư mục cho một thành phần, kèm tệp định dạng riêng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="250" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="scFe3" value="&lt;b&gt;hooks/&lt;/b&gt; — useSocket · useInfiniteList · useLoading · useSnackbar&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Các hook danh sách cuộn vô hạn kỳ vọng đúng cấu trúc phân trang mà backend trả về&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="350" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scFe4" value="&lt;b&gt;Trạng thái dùng chung&lt;/b&gt; — React Context + useReducer&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;AuthUser · Loading · Snackbar · UpdateProfile · globalSocketState&lt;br&gt;&lt;i&gt;Redux có trong khai báo phụ thuộc nhưng KHÔNG được dùng&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="460" width="460" height="85" as="geometry" />
        </mxCell>
        <mxCell id="scFe5" value="&lt;b&gt;api/*Service.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Một tệp cho một miền nghiệp vụ. Thành phần giao diện KHÔNG gọi HTTP trực tiếp.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="575" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="scFe6" value="&lt;b&gt;api/axiosConfig.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Gắn header Authorization; tự động đổi refresh token khi gặp 401 và gọi lại request gốc một lần&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="675" width="460" height="80" as="geometry" />
        </mxCell>

        <mxCell id="scBe" value="BACKEND — Spring Boot 2.5 / Java 11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=center;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="700" height="810" as="geometry" />
        </mxCell>
        <mxCell id="scSec" value="&lt;b&gt;security/&lt;/b&gt; — chuỗi lọc trước mọi xử lý&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Đọc JWT từ header · phiên không trạng thái · CORS theo danh sách origin&lt;br&gt;Phân quyền khai báo tập trung ở MỘT chỗ duy nhất&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="150" width="640" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scCtrl" value="&lt;b&gt;controller/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Một lớp cho một tài nguyên. Rất mỏng: kiểm tra đầu vào, gọi service, trả đối tượng truyền dữ liệu. Tiền tố chung /api/v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="260" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="scSvc" value="&lt;b&gt;service/ + service/impl/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Toàn bộ quy tắc nghiệp vụ. Bao gồm service/report/ cho kiểm duyệt và service/recommendation/ cho gợi ý kết bạn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="360" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="scMap" value="&lt;b&gt;mapper/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Chuyển thực thể thành đối tượng truyền dữ liệu, đồng thời bổ sung số liệu đếm và cờ trạng thái của người dùng hiện tại&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="460" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scEvt" value="&lt;b&gt;event/ + event/handler/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;11 sự kiện, mọi bộ xử lý đều chạy bất đồng bộ. Hai kênh phát: email và WebSocket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="460" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scRepo" value="&lt;b&gt;repository/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Truy vấn theo Spring Data JPA. Mọi truy vấn phải TỰ thêm điều kiện active — không có bộ lọc toàn cục&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="570" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scDao" value="&lt;b&gt;dao/ + dao/impl/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Gọi hàm lưu trữ của PostgreSQL theo tên. Dùng cho thống kê và cho dữ liệu đầu vào của gợi ý kết bạn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="570" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scEnt" value="&lt;b&gt;entity/&lt;/b&gt; — 19 bảng&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Năm kiểu kế thừa lớp có dấu vết thay đổi và cờ active (xoá mềm). Không dùng thư viện sinh mã; toàn bộ là lớp viết tay.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="680" width="640" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scStomp" value="&lt;b&gt;configuration/&lt;/b&gt; — broker STOMP, lập lịch, lưu trữ ảnh, tra cứu vị trí, tài liệu API&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Tác vụ định kỳ đáng chú ý: làm mới bảng gợi ý kết bạn mỗi 5 phút&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="790" width="640" height="80" as="geometry" />
        </mxCell>

        <mxCell id="scDb" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;19 bảng&lt;br&gt;14 hàm lưu trữ&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1520" y="570" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="scNotify" value="&lt;b&gt;Hai kênh thông báo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Email: chỉ dùng cho mã xác thực và kết quả kiểm duyệt&lt;br&gt;&lt;br&gt;WebSocket: mọi thông báo tương tác (thích, bình luận, theo dõi) và toàn bộ tin nhắn chat&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1520" y="430" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="scEa" value="HTTP + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#10739e;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;fontStyle=1;" edge="1" parent="1" source="scFe6" target="scSec">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="715" />
              <mxPoint x="640" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="scEb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="scSec" target="scCtrl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scEc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="scCtrl" target="scSvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scEd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="scSvc" target="scMap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scEe" value="phát sự kiện" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d79b00;exitX=0.75;exitY=1;entryX=0.5;entryY=0;fontSize=10;" edge="1" parent="1" source="scSvc" target="scEvt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scEf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="scMap" target="scRepo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scEg" value="thống kê" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;" edge="1" parent="1" source="scEvt" target="scDao">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scEh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="scRepo" target="scEnt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scEi" value="gọi hàm lưu trữ theo tên" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="scDao" target="scDb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scEj" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="scEnt" target="scDb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scEk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d79b00;exitX=1;exitY=0.25;entryX=0;entryY=0.75;" edge="1" parent="1" source="scEvt" target="scNotify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="scConv" value="&lt;b&gt;QUY ƯỚC MÃ NGUỒN ĐƯỢC XÁC NHẬN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;• Tiêm phụ thuộc qua hàm khởi tạo, không dùng tiêm trực tiếp vào trường.&lt;br&gt;• Lớp điều khiển mỏng; không chứa quy tắc nghiệp vụ.&lt;br&gt;• Tham số phân trang chuẩn: _sort (mặc định id), _order (mặc định tăng), limit (mặc định 12), page (mặc định 0).&lt;br&gt;• Xoá là xoá mềm: chỉ đổi cờ active. Năm kiểu dữ liệu có cờ này.&lt;br&gt;• Việc phát sinh hệ quả phụ đi qua bus sự kiện, không gọi trực tiếp trong lớp nghiệp vụ.&lt;br&gt;• Thống kê thuộc về lớp truy cập dữ liệu viết tay, gọi hàm lưu trữ của PostgreSQL.&lt;br&gt;&lt;br&gt;&lt;b&gt;Giao diện&lt;/b&gt;&lt;br&gt;• Một thư mục cho một thành phần, kèm tệp định dạng đặt cạnh.&lt;br&gt;• Nhập khẩu theo đường dẫn tuyệt đối tính từ thư mục nguồn.&lt;br&gt;• Mọi lệnh gọi HTTP nằm trong tệp dịch vụ, không gọi thẳng từ thành phần giao diện.&lt;br&gt;• Văn bản hiển thị đi qua cơ chế đa ngôn ngữ, có hai bộ từ khoá: tiếng Anh và tiếng Việt." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#666666;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="640" height="320" as="geometry" />
        </mxCell>

        <mxCell id="scRisk" value="&lt;b&gt;ĐIỂM KIẾN TRÚC CẦN LƯU Ý&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Phân quyền tập trung ở một chỗ, và đó là điểm mạnh lẫn điểm yếu.&lt;/b&gt; Toàn bộ quy tắc truy cập nằm trong tám dòng khai báo. Dễ đọc, nhưng một đường dẫn viết sai sẽ tạo ra quy tắc không bao giờ khớp, và không có cảnh báo nào — xem phần rủi ro trong tài liệu BA.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Mô hình dữ liệu không có quan hệ hai chiều.&lt;/b&gt; Mọi liên kết đều là một chiều từ phía nhiều trỏ về phía một. Phía một không giữ danh sách con, nên mọi phép đếm và mọi danh sách con đều là một truy vấn riêng. Đây là nguyên nhân kiến trúc của chi phí độ trễ nêu ở trang trước.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Lược đồ cơ sở dữ liệu không có nguồn sự thật duy nhất.&lt;/b&gt; Tệp lược đồ trong repo chỉ tạo 11 trong 19 bảng; 8 bảng còn lại do cơ chế tự cập nhật lược đồ của tầng ánh xạ sinh ra lúc khởi động. Hệ quả: dựng môi trường mới phải khôi phục từ bản sao lưu, không dùng tệp lược đồ.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Xoá mềm là quy ước, không phải cơ chế được bảo đảm.&lt;/b&gt; Không có bộ lọc toàn cục, nên mỗi truy vấn mới phải tự nhớ thêm điều kiện; quên là trả về cả dữ liệu đã xoá." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#fff4f4;strokeColor=#b85450;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="940" width="1080" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sa-solution" name="3. Kiến trúc giải pháp — đối chiếu mã nguồn">
    <mxGraphModel dx="2600" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
