        <mxCell id="s3Title" value="VIVACON — KIẾN TRÚC GIẢI PHÁP (AS-IS), MỖI KHỐI GHI FILE/LỚP LÀM BẰNG CHỨNG&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Chỉ vẽ thành phần có đường gọi thật trong mã nguồn. Thứ có trong repo nhưng không ai gọi nằm ở ô xám phía dưới.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3cBrowser" value="TRÌNH DUYỆT — React 17 SPA (frontend/src)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fontStyle=1;fontSize=12;collapsible=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="400" height="800" as="geometry" />
