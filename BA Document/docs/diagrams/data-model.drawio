          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dmR9" value="1 — N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=0.25;exitY=1;entryX=0.25;entryY=0;fontSize=11;endArrow=ERmany;endFill=0;" edge="1" parent="1" source="dmPost" target="dmLiking">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dmR10" value="1 — N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.8;entryX=1;entryY=0.2;fontSize=11;endArrow=ERmany;endFill=0;" edge="1" parent="1" source="dmPost" target="dmComment">
          <mxGeometry relative="1" as="geometry">
