<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="dm-core" name="1. Mô hình dữ liệu — cốt lõi">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dmTitle" value="MÔ HÌNH DỮ LIỆU — NHÓM CỐT LÕI: TÀI KHOẢN, NỘI DUNG, QUAN HỆ XÃ HỘI&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;9 trong 19 bảng. Nhóm còn lại (chat, thông báo, thiết lập, thiết bị, kiểm duyệt) nằm ở trang 2.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1880" height="50" as="geometry" />
        </mxCell>

        <mxCell id="dmRole" value="&lt;b&gt;role&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Vai trò hệ thống&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;name — duy nhất&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Là chuỗi tự do, KHÔNG phải kiểu liệt kê: cơ sở dữ liệu không ràng buộc giá trị phải thuộc USER / ADMIN / SUPER_ADMIN.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="dmFollowing" value="&lt;b&gt;following&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Quan hệ theo dõi (một chiều)&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;FK  from_account → account&lt;br&gt;FK  to_account → account&lt;br&gt;&lt;br&gt;Duy nhất theo cặp (from, to).&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Không có cờ xoá mềm: bỏ theo dõi là XOÁ HẲN bản ghi. Muốn thể hiện &quot;bạn bè&quot; phải có hai bản ghi ngược chiều.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="280" height="200" as="geometry" />
        </mxCell>

        <mxCell id="dmAccount" value="&lt;b&gt;account&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Tài khoản người dùng — thực thể trung tâm của toàn hệ thống&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;username — duy nhất, bắt buộc&lt;br&gt;email — duy nhất, bắt buộc&lt;br&gt;password — băm BCrypt&lt;br&gt;full_name — bắt buộc&lt;br&gt;FK  role_id → role&lt;br&gt;bio — tối đa 200 ký tự&lt;br&gt;phone_number · gender · public_key&lt;br&gt;refresh_token · token_expired_date&lt;br&gt;verification_token · verification_expired_date&lt;br&gt;&lt;b&gt;account_status&lt;/b&gt; — ACTIVE / INACTIVE / STILL_NOT_ACTIVE / BANNED&lt;br&gt;&lt;br&gt;&lt;i&gt;Trường theo dấu vết thay đổi (kế thừa):&lt;/i&gt;&lt;br&gt;FK created_by_account_id · created_at&lt;br&gt;FK last_modified_by_account_id · last_modified_at&lt;br&gt;&lt;b&gt;active&lt;/b&gt; — cờ xoá mềm&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;CÓ HAI khái niệm trạng thái độc lập: active (đã xoá mềm hay chưa) và account_status (vòng đời tài khoản). Tài khoản bị khoá vẫn có active = true.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="140" width="360" height="430" as="geometry" />
        </mxCell>

        <mxCell id="dmPost" value="&lt;b&gt;post&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Bài đăng&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;caption — bắt buộc, tối đa 1500 ký tự&lt;br&gt;&lt;b&gt;privacy&lt;/b&gt; — 0 = chỉ mình tôi, 1 = người theo dõi, 2 = công khai&lt;br&gt;&lt;br&gt;&lt;i&gt;Trường theo dấu vết thay đổi:&lt;/i&gt;&lt;br&gt;FK created_by_account_id · created_at&lt;br&gt;FK last_modified_by_account_id · last_modified_at&lt;br&gt;&lt;b&gt;active&lt;/b&gt; — cờ xoá mềm&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;KHÔNG có trường tác giả riêng. Chủ sở hữu bài đăng chính là created_by_account_id. Đây là điểm dễ mô hình hoá sai nhất.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="140" width="340" height="240" as="geometry" />
        </mxCell>

        <mxCell id="dmLiking" value="&lt;b&gt;liking&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Lượt thích — bảng nối giữa tài khoản và bài đăng&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;FK  account_id → account&lt;br&gt;FK  post_id → post&lt;br&gt;&lt;br&gt;Duy nhất theo cặp (account_id, post_id) — mỗi người chỉ thích một bài một lần.&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Bỏ thích là XOÁ HẲN bản ghi.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="430" width="340" height="170" as="geometry" />
        </mxCell>

        <mxCell id="dmComment" value="&lt;b&gt;comment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Bình luận, có cấu trúc cây&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;content — tối đa 1500 ký tự ở tầng dữ liệu&lt;br&gt;FK  post_id → post&lt;br&gt;FK  parent_comment_id → comment  (tự tham chiếu)&lt;br&gt;&lt;br&gt;&lt;i&gt;Trường theo dấu vết thay đổi:&lt;/i&gt;&lt;br&gt;FK created_by_account_id · created_at&lt;br&gt;FK last_modified_by_account_id · last_modified_at&lt;br&gt;&lt;b&gt;active&lt;/b&gt; — cờ xoá mềm&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;Lược đồ cho phép cây sâu vô hạn. Giới hạn hai cấp chỉ tồn tại ở API đọc, không phải ở mô hình dữ liệu.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="650" width="340" height="250" as="geometry" />
        </mxCell>

        <mxCell id="dmAttachment" value="&lt;b&gt;attachment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Tệp ảnh đã tải lên&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;url — đường dẫn trên dịch vụ lưu trữ&lt;br&gt;actual_name · unique_name · timestamp&lt;br&gt;FK  post_id → post      (ảnh của bài đăng)&lt;br&gt;FK  profile_id → account (ảnh đại diện)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Hai khoá ngoại đều cho phép rỗng và KHÔNG có ràng buộc nào bắt buộc đúng một trong hai phải có giá trị. Quy tắc đó chỉ tồn tại trong mã nghiệp vụ.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1400" y="140" width="330" height="210" as="geometry" />
        </mxCell>

        <mxCell id="dmHtrp" value="&lt;b&gt;hashtag_rel_post&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Bảng nối giữa hashtag và bài đăng&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;FK  hashtag_id → hashtag&lt;br&gt;FK  post_id → post&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;KHÔNG có ràng buộc duy nhất, nên ở mức dữ liệu cùng một hashtag có thể gắn trùng vào cùng một bài đăng.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1400" y="430" width="330" height="170" as="geometry" />
        </mxCell>

        <mxCell id="dmHashtag" value="&lt;b&gt;hashtag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Thẻ chủ đề&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;name — bắt buộc, duy nhất&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;Tên được lưu KÈM dấu thăng ở đầu. Biểu thức trích xuất từ chú thích không nhận ký tự tiếng Việt có dấu, nên hashtag tiếng Việt sẽ bị cắt.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1400" y="680" width="330" height="170" as="geometry" />
        </mxCell>

