        <mxCell id="d2Settings" value="&lt;b&gt;BẢY THIẾT LẬP CÁ NHÂN VÀ GIÁ TRỊ MẶC ĐỊNH&lt;/b&gt;" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
