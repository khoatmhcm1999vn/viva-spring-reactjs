          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="dmLegend" value="CHÚ GIẢI VÀ QUY ƯỚC ĐỌC SƠ ĐỒ" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="780" height="300" as="geometry" />
        </mxCell>
        <mxCell id="dmLg1" value="Thực thể trung tâm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="dmLegend">
          <mxGeometry x="20" y="45" width="175" height="42" as="geometry" />
        </mxCell>
        <mxCell id="dmLg2" value="Thực thể nội dung&#10;(có xoá mềm)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="dmLegend">
          <mxGeometry x="205" y="45" width="175" height="42" as="geometry" />
        </mxCell>
        <mxCell id="dmLg3" value="Bảng nối / bảng phụ&#10;(KHÔNG có xoá mềm)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="dmLegend">
          <mxGeometry x="390" y="45" width="175" height="42" as="geometry" />
        </mxCell>
        <mxCell id="dmLg4" value="Bảng cấu hình" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="dmLegend">
          <mxGeometry x="575" y="45" width="175" height="42" as="geometry" />
        </mxCell>
        <mxCell id="dmLg5" value="&lt;b&gt;Ký hiệu đầu đường nối&lt;/b&gt;: chân chẻ ba đặt ở phía &quot;nhiều&quot;. Nhãn ghi rõ chiều quan hệ, ví dụ &quot;1 — N là tác giả của&quot;.&lt;br&gt;&lt;b&gt;Màu đường nối&lt;/b&gt; theo màu của bảng ở phía &quot;nhiều&quot;, để dễ lần theo khi có nhiều đường cùng xuất phát từ bảng account." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#666666;spacingLeft=8;spacingTop=6;" vertex="1" parent="dmLegend">
          <mxGeometry x="20" y="100" width="730" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dmLg6" value="&lt;b&gt;BA ĐIỀU PHẢI BIẾT TRƯỚC KHI ĐỌC MÔ HÌNH NÀY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Không có một quan hệ hai chiều nào trong mã nguồn.&lt;/b&gt; Mọi liên kết đều khai báo một chiều, từ phía &quot;nhiều&quot; trỏ về phía &quot;một&quot; bằng một khoá ngoại. Phía &quot;một&quot; không giữ danh sách con. Sơ đồ vẫn vẽ đủ bản số, nhưng đừng mô tả là &quot;bài đăng có danh sách bình luận&quot; — cấu trúc đó không tồn tại, mọi danh sách con đều là một truy vấn riêng.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Chủ sở hữu tài nguyên nằm ở lớp cha, không nằm ở bảng con.&lt;/b&gt; Bài đăng, bình luận, hội thoại và báo cáo đều xác định chủ sở hữu bằng trường người tạo được kế thừa, chứ không có trường tác giả riêng.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Xoá mềm chỉ áp cho 8 trong 19 bảng.&lt;/b&gt; Các bảng nối như lượt thích, quan hệ theo dõi, thành viên hội thoại đều bị xoá hẳn khi người dùng hoàn tác hành động." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#fff8e1;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;" vertex="1" parent="dmLegend">
          <mxGeometry x="20" y="170" width="730" height="130" as="geometry" />
        </mxCell>

        <mxCell id="dmSchemaNote" value="&lt;b&gt;LƯU Ý QUAN TRỌNG VỀ LƯỢC ĐỒ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tệp lược đồ trong repo chỉ tạo &lt;b&gt;11 trong 19 bảng&lt;/b&gt;. Tám bảng còn lại — thiết bị đăng nhập, hashtag, bảng nối hashtag, thông báo, và bốn bảng của nhóm kiểm duyệt — chỉ xuất hiện khi backend khởi động, do cơ chế tự cập nhật lược đồ của tầng ánh xạ dữ liệu sinh ra.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hệ quả thực tế:&lt;/b&gt; dựng một môi trường mới phải &lt;b&gt;khôi phục từ bản sao lưu&lt;/b&gt;, không dùng tệp lược đồ. Một hàm thống kê đã được kiểm chứng là lỗi khi lược đồ chỉ dựng từ tệp đó, vì bảng thiết bị đăng nhập chưa tồn tại.&lt;br&gt;&lt;br&gt;Tệp lược đồ còn lệch so với mã nguồn ở ba chỗ: bảng tài khoản thiếu ba cột, bảng tin nhắn có một cột không dùng và thiếu cột loại tin nhắn. Nói cách khác, tệp đó không còn là nguồn sự thật." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#fff4f4;strokeColor=#b85450;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="890" width="520" height="280" as="geometry" />
        </mxCell>

        <mxCell id="dmPrivacy" value="&lt;b&gt;BẢNG MÃ: MỨC RIÊNG TƯ CỦA BÀI ĐĂNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;Giá trị được lưu dưới dạng SỐ THỨ TỰ, nên thứ tự khai báo là một phần hợp đồng dữ liệu: đảo thứ tự sẽ làm sai toàn bộ dữ liệu cũ.&lt;br&gt;&lt;br&gt;&lt;b&gt;0 — Chỉ mình tôi&lt;/b&gt;&lt;br&gt;&lt;b&gt;1 — Người theo dõi&lt;/b&gt;&lt;br&gt;&lt;b&gt;2 — Công khai&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Việc thực thi mức riêng tư &lt;b&gt;không đồng nhất&lt;/b&gt;: đường xem qua hồ sơ có lọc đúng, newsfeed chỉ lấy mức 1 và 2, nhưng endpoint tìm kiếm bài đăng tổng quát lại nhận danh sách mức riêng tư &lt;i&gt;từ phía client&lt;/i&gt; nên không có thực thi phía máy chủ.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#666666;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="930" width="480" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="dm-ext" name="2. Mô hình dữ liệu — mở rộng">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="d2Title" value="MÔ HÌNH DỮ LIỆU — NHÓM MỞ RỘNG: CHAT, THÔNG BÁO, THIẾT LẬP, THIẾT BỊ, KIỂM DUYỆT&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;10 trong 19 bảng. Bảng account được vẽ lại ở dạng rút gọn để làm điểm neo.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1880" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d2Account" value="&lt;b&gt;account&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;(rút gọn — xem chi tiết ở trang 1)&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;username · email · full_name&lt;br&gt;account_status&lt;br&gt;active&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="740" y="500" width="300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="d2Conv" value="&lt;b&gt;conversation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Hội thoại&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;name — bắt buộc, ghép từ họ tên các thành viên&lt;br&gt;&lt;br&gt;&lt;i&gt;Trường theo dấu vết thay đổi:&lt;/i&gt;&lt;br&gt;FK created_by_account_id · created_at&lt;br&gt;FK last_modified_by_account_id · last_modified_at&lt;br&gt;&lt;b&gt;active&lt;/b&gt; — cờ xoá mềm&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;Mỗi tin nhắn mới đều cập nhật thời điểm thay đổi của hội thoại — đó là cách danh sách chat được sắp xếp.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="320" height="220" as="geometry" />
        </mxCell>

        <mxCell id="d2Part" value="&lt;b&gt;participant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Thành viên hội thoại — bảng nối&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;FK  conversation_id → conversation (bắt buộc)&lt;br&gt;FK  account_id → account (bắt buộc)&lt;br&gt;&lt;br&gt;Duy nhất theo cặp (conversation_id, account_id).&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Không có khái niệm quản trị nhóm, và không tìm thấy API rời nhóm hay xoá thành viên.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="320" height="190" as="geometry" />
        </mxCell>

        <mxCell id="d2Msg" value="&lt;b&gt;message&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Tin nhắn&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;content — bắt buộc&lt;br&gt;timestamp — bắt buộc&lt;br&gt;status — 0 đã gửi, 1 đã nhận, 2 đã xem&lt;br&gt;message_type — 0 đang gõ, 1 văn bản thường, 2 có thành viên mới&lt;br&gt;FK  sender_id → account&lt;br&gt;FK  recipient_id → &lt;b&gt;conversation&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Tên trường gây nhầm: &quot;người nhận&quot; thực chất trỏ tới một HỘI THOẠI, không phải một người. Tin nhắn luôn gửi vào hội thoại.&lt;br&gt;&lt;br&gt;Trạng thái đã xem có trong mô hình nhưng KHÔNG tìm thấy luồng nào cập nhật nó.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="320" height="280" as="geometry" />
        </mxCell>

        <mxCell id="d2Notif" value="&lt;b&gt;notification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Thông báo trong ứng dụng&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;type — 11 loại (bình luận, trả lời, thích, được theo dõi, kết quả kiểm duyệt…)&lt;br&gt;title · content · timestamp · status&lt;br&gt;FK  action_author_id → account  (người gây ra hành động)&lt;br&gt;FK  receiver_id → account  (người nhận)&lt;br&gt;presentation_id · trace_id&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Hai trường cuối là số nguyên trần, KHÔNG phải khoá ngoại và không có ràng buộc. Ý nghĩa nghiệp vụ của chúng không suy ra được từ mô hình dữ liệu.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="740" width="320" height="280" as="geometry" />
        </mxCell>

        <mxCell id="d2Setting" value="&lt;b&gt;setting&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Thiết lập cá nhân — 7 bản ghi cho mỗi tài khoản&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;FK  account_id → account (bắt buộc)&lt;br&gt;type — tên thiết lập&lt;br&gt;value — giá trị, luôn là đúng/sai&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;KHÔNG có ràng buộc duy nhất theo cặp (tài khoản, loại thiết lập), nên ở mức dữ liệu có thể tồn tại thiết lập trùng.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1100" y="740" width="320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="d2Device" value="&lt;b&gt;device_metadata&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Thiết bị và vị trí đăng nhập&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;device — dòng thiết bị và phiên bản&lt;br&gt;country · city · latitude · longitude&lt;br&gt;last_logged_in&lt;br&gt;FK  account_id → account&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Trường &quot;city&quot; thực tế lưu múi giờ tra được từ địa chỉ IP, không phải tên thành phố.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1100" y="490" width="320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="d2RtGroup" value="NHÓM KIỂM DUYỆT — kế thừa theo chiến lược JOINED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4f4;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1480" y="100" width="440" height="700" as="geometry" />
        </mxCell>
        <mxCell id="d2Rt" value="&lt;b&gt;report_template&lt;/b&gt;  (bảng CHA)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Báo cáo vi phạm — phần dùng chung&lt;/i&gt;&lt;br&gt;&lt;br&gt;PK  id&lt;br&gt;content — bắt buộc, tối đa 3000 ký tự&lt;br&gt;sentitive_type — nhóm vi phạm: khiêu dâm, bạo lực, tự hại, khủng bố, spam, khác&lt;br&gt;&lt;br&gt;&lt;i&gt;Trường theo dấu vết thay đổi:&lt;/i&gt;&lt;br&gt;FK created_by_account_id — &lt;b&gt;người tố cáo&lt;/b&gt;&lt;br&gt;FK last_modified_by_account_id — &lt;b&gt;người xử lý&lt;/b&gt;&lt;br&gt;&lt;b&gt;active&lt;/b&gt; — true = chờ xử lý, false = đã đóng&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;KHÔNG có cột trạng thái. Duyệt và từ chối đều đặt active = false nên hai quyết định không phân biệt được trong dữ liệu.&lt;br&gt;&lt;br&gt;Tên bảng gây nhầm: đây KHÔNG phải danh mục mẫu lý do tố cáo.&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1510" y="150" width="380" height="310" as="geometry" />
        </mxCell>
        <mxCell id="d2Ar" value="&lt;b&gt;account_report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;PK/FK id → report_template&lt;br&gt;FK account_id → account  &lt;i&gt;(bị tố cáo)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1510" y="530" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d2Pr" value="&lt;b&gt;post_report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;PK/FK id → report_template&lt;br&gt;FK post_id → post  &lt;i&gt;(bị tố cáo)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1510" y="620" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d2Cr" value="&lt;b&gt;comment_report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;PK/FK id → report_template&lt;br&gt;FK comment_id → comment  &lt;i&gt;(bị tố cáo)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1510" y="710" width="380" height="70" as="geometry" />
        </mxCell>

