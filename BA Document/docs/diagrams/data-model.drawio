        <mxCell id="dm-phys-core_lgs2" value="" style="endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;html=1;strokeColor=#C26A00;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#C26A00;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1014" as="sourcePoint" /><mxPoint x="160" y="1014" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dm-phys-core_lgt2" value="@ManyToOne + @JoinColumn, KHÔNG có trong schema.sql — &lt;b&gt;INFERRED&lt;/b&gt;: FK do Hibernate ddl-auto sinh, chưa kiểm trên DB thật" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="dm-phys-core_lg">
          <mxGeometry x="135" y="122" width="805" height="32" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-core_lgh1" value="&lt;b&gt;bảng có trong schema.sql&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="dm-phys-core_lg">
          <mxGeometry x="20" y="166" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-core_lgh2" value="&lt;b&gt;bảng chỉ có ở JPA&lt;/b&gt; (viền nét đứt)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;dashPattern=6 3;" vertex="1" parent="dm-phys-core_lg">
          <mxGeometry x="235" y="166" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-core_lgh3" value="&lt;b&gt;bảng tham chiếu&lt;/b&gt; (chi tiết ở trang khác)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="dm-phys-core_lg">
          <mxGeometry x="470" y="166" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-core_lgm" value="&lt;b&gt;PK&lt;/b&gt; khoá chính · &lt;b&gt;FK&lt;/b&gt; khoá ngoại · &lt;b&gt;UK&lt;/b&gt; UNIQUE một cột · &lt;b&gt;PF&lt;/b&gt; vừa PK vừa FK (JOINED) · &lt;b&gt;NN&lt;/b&gt; NOT NULL&lt;br&gt;&lt;b&gt;†&lt;/b&gt; cột do JPA thêm, không có trong schema.sql · &lt;b&gt;‡&lt;/b&gt; cột chỉ có trong schema.sql, không được ánh xạ · &lt;b&gt;*&lt;/b&gt; DDL và JPA khác nhau (xem trang 5)&lt;br&gt;Chân chim phía FK: vòng + chẻ ba = 0..N. Phía bảng được tham chiếu: vòng + vạch = 0..1 (FK cho phép NULL), hai vạch = đúng 1 (FK NOT NULL)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="dm-phys-core_lg">
          <mxGeometry x="20" y="206" width="920" height="76" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-core_lgp" value="&lt;i&gt;Nguồn: branch feature/ai-assisted-dev-setup @ ca46696 (working tree), sinh ngày 2026-10-10. DDL/JPA-derived, KHÔNG đối chiếu DB đang chạy.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#455A64;" vertex="1" parent="dm-phys-core_lg">
          <mxGeometry x="20" y="286" width="920" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p3Notes" value="&lt;b&gt;GHI CHÚ VẬT LÝ (đọc từ mã nguồn)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Index:&lt;/b&gt; ngoài PK và UNIQUE, không có index nào được khai báo (schema.sql không có CREATE INDEX, entity không dùng @Index). PostgreSQL không tự tạo index cho cột FK.&lt;br&gt;• &lt;b&gt;Xoá mềm:&lt;/b&gt; cột &lt;b&gt;active&lt;/b&gt; chỉ có ở các bảng kế thừa AuditableEntity: account, post, comment (trang này), conversation, report_template (trang 4). Các bảng nối bị xoá vật lý.&lt;br&gt;• &lt;b&gt;ON DELETE:&lt;/b&gt; mọi FK trong schema.sql là NO ACTION; không có cascade ở mức DB.&lt;br&gt;• &lt;b&gt;device_metadata.city&lt;/b&gt; thực tế lưu múi giờ: DeviceServiceImpl.verifyDevice gán city = location.getLocation().getTimeZone().&lt;br&gt;• &lt;b&gt;post&lt;/b&gt; không có cột tác giả riêng: chủ sở hữu là created_by_account_id.&lt;br&gt;• Kiểu của bảng chỉ có ở JPA là kiểu mặc định của Hibernate cho PostgreSQL (Long→bigint, String→varchar(255), LocalDateTime→timestamp, Double→float8), chưa kiểm trên DB thật." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;spacingRight=8;fillColor=#FFF8E1;strokeColor=#D6B656;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1040" y="876" width="1020" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
