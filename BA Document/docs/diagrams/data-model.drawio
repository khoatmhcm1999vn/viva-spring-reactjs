        <mxCell id="dm-phys-msg_lgt0" value="FK khai báo trong schema.sql — &lt;b&gt;VERIFIED (DDL)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="dm-phys-msg_lg">
          <mxGeometry x="135" y="46" width="805" height="32" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-msg_lgs1" value="" style="endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="60" y="956" as="sourcePoint" /><mxPoint x="160" y="956" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dm-phys-msg_lgt1" value="FK audit created_by / last_modified_by trong schema.sql — &lt;b&gt;VERIFIED (DDL)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="dm-phys-msg_lg">
          <mxGeometry x="135" y="84" width="805" height="32" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-msg_lgs2" value="" style="endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;html=1;strokeColor=#C26A00;strokeWidth=1.5;dashed=1;dashPattern=8 4;fontColor=#C26A00;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="60" y="994" as="sourcePoint" /><mxPoint x="160" y="994" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dm-phys-msg_lgt2" value="@ManyToOne + @JoinColumn, KHÔNG có trong schema.sql — &lt;b&gt;INFERRED&lt;/b&gt;: FK do Hibernate ddl-auto sinh, chưa kiểm trên DB thật" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="dm-phys-msg_lg">
          <mxGeometry x="135" y="122" width="805" height="32" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-msg_lgh1" value="&lt;b&gt;bảng có trong schema.sql&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="dm-phys-msg_lg">
          <mxGeometry x="20" y="166" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-msg_lgh2" value="&lt;b&gt;bảng chỉ có ở JPA&lt;/b&gt; (viền nét đứt)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;dashPattern=6 3;" vertex="1" parent="dm-phys-msg_lg">
          <mxGeometry x="235" y="166" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-msg_lgh3" value="&lt;b&gt;bảng tham chiếu&lt;/b&gt; (chi tiết ở trang khác)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="dm-phys-msg_lg">
          <mxGeometry x="470" y="166" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-msg_lgm" value="&lt;b&gt;PK&lt;/b&gt; khoá chính · &lt;b&gt;FK&lt;/b&gt; khoá ngoại · &lt;b&gt;UK&lt;/b&gt; UNIQUE một cột · &lt;b&gt;PF&lt;/b&gt; vừa PK vừa FK (JOINED) · &lt;b&gt;NN&lt;/b&gt; NOT NULL&lt;br&gt;&lt;b&gt;†&lt;/b&gt; cột do JPA thêm, không có trong schema.sql · &lt;b&gt;‡&lt;/b&gt; cột chỉ có trong schema.sql, không được ánh xạ · &lt;b&gt;*&lt;/b&gt; DDL và JPA khác nhau (xem trang 5)&lt;br&gt;Chân chim phía FK: vòng + chẻ ba = 0..N. Phía bảng được tham chiếu: vòng + vạch = 0..1 (FK cho phép NULL), hai vạch = đúng 1 (FK NOT NULL)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="dm-phys-msg_lg">
          <mxGeometry x="20" y="206" width="920" height="76" as="geometry" />
        </mxCell>
        <mxCell id="dm-phys-msg_lgp" value="&lt;i&gt;Nguồn: branch feature/ai-assisted-dev-setup @ ca46696 (working tree), sinh ngày 2026-10-10. DDL/JPA-derived, KHÔNG đối chiếu DB đang chạy.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#455A64;" vertex="1" parent="dm-phys-msg_lg">
          <mxGeometry x="20" y="286" width="920" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p4Notes" value="&lt;b&gt;GHI CHÚ VẬT LÝ (đọc từ mã nguồn)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;message.recipient_id&lt;/b&gt; là FK tới &lt;b&gt;conversation&lt;/b&gt;, không tới account (fk2a3ajdqt4au2cns4ko5m5qiil). Tên cột dễ gây hiểu nhầm.&lt;br&gt;• &lt;b&gt;notification.presentation_id / trace_id&lt;/b&gt; là id đa hình (bài đăng, bình luận… tuỳ &lt;b&gt;type&lt;/b&gt;), KHÔNG có FK — vì vậy không vẽ đường nối.&lt;br&gt;• &lt;b&gt;notification.status&lt;/b&gt; và &lt;b&gt;message.status&lt;/b&gt; lưu enum MessageStatus theo ORDINAL (0 SENT, 1 RECEIVED, 2 SEEN); notification.status không khai @Enumerated nên dùng mặc định ORDINAL.&lt;br&gt;• &lt;b&gt;Kiểm duyệt&lt;/b&gt; dùng @Inheritance(JOINED): mỗi báo cáo có một dòng ở report_template và một dòng ở bảng con, cùng id. FK id → report_template.id do Hibernate sinh (INFERRED).&lt;br&gt;• Tên bảng con lấy từ @Entity(name = &quot;AccountReport&quot;…) qua naming strategy mặc định → account_report, post_report, comment_report (INFERRED, chưa kiểm DB thật).&lt;br&gt;• report_template.sentitive_type: NUDITY, VIOLENCE, SUICIDE, TERRORISM, SPAM, OTHER (EnumType.STRING)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;spacingRight=8;fillColor=#FFF8E1;strokeColor=#D6B656;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1040" y="856" width="1440" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dm-phys-diff" name="5. Đối chiếu schema.sql ↔ JPA">
