          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dmR6" value="1 — N&#10;là tác giả của" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0;entryY=0.3;fontSize=10;endArrow=ERmany;endFill=0;" edge="1" parent="1" source="dmAccount" target="dmComment">
          <mxGeometry relative="1" as="geometry">
