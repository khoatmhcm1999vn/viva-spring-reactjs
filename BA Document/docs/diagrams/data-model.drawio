        <mxCell id="d2s1" value="Nhận email kết quả xử lý báo cáo&#10;Mặc định: BẬT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="d2Settings">
          <mxGeometry x="15" y="40" width="290" height="34" as="geometry" />
