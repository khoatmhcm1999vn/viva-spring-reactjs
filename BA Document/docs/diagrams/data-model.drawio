        </mxCell>
        <mxCell id="d2s3" value="Thông báo khi có bình luận&#10;Mặc định: BẬT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="d2Settings">
          <mxGeometry x="15" y="120" width="290" height="34" as="geometry" />
        </mxCell>
        <mxCell id="d2s4" value="Thông báo khi có người thích&#10;Mặc định: BẬT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="d2Settings">
          <mxGeometry x="15" y="160" width="290" height="34" as="geometry" />
        </mxCell>
        <mxCell id="d2s5" value="Thông báo khi có người theo dõi&#10;Mặc định: BẬT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="d2Settings">
          <mxGeometry x="15" y="200" width="290" height="34" as="geometry" />
        </mxCell>
        <mxCell id="d2s6" value="Hiển thị trạng thái đang hoạt động&#10;Mặc định: BẬT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="d2Settings">
          <mxGeometry x="15" y="240" width="290" height="34" as="geometry" />
        </mxCell>
        <mxCell id="d2s7" value="Cảnh báo đăng nhập từ thiết bị / vị trí mới&#10;Mặc định: TẮT — nên luồng xác minh thiết bị mặc định không chạy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="d2Settings">
          <mxGeometry x="15" y="280" width="290" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d2Note" value="&lt;b&gt;VÌ SAO TÁCH THÀNH HAI TRANG&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mười chín bảng vẽ chung một trang sẽ cho ra hơn hai mươi đường nối đều hội tụ về bảng account, và hình vẽ trở nên không đọc được. Vì vậy mô hình được chia theo nhóm nghiệp vụ:&lt;br&gt;&lt;br&gt;&lt;b&gt;Trang 1&lt;/b&gt; — tài khoản, nội dung, quan hệ xã hội: 9 bảng, là phần mọi người dùng chạm vào hằng ngày.&lt;br&gt;&lt;b&gt;Trang 2&lt;/b&gt; — nhắn tin, thông báo, thiết lập, thiết bị, kiểm duyệt: 10 bảng, là phần hỗ trợ và vận hành.&lt;br&gt;&lt;br&gt;Bảng account xuất hiện ở cả hai trang: ở trang 1 là đầy đủ, ở trang 2 là bản rút gọn dùng làm điểm neo. Đây là cách giữ cho mỗi trang đọc được mà không mất mối liên hệ." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#666666;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="980" width="820" height="200" as="geometry" />
        </mxCell>

        <mxCell id="d2Legend" value="CHÚ GIẢI" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="420" y="1060" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d2Lg1" value="Thực thể trung tâm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="d2Legend">
          <mxGeometry x="15" y="40" width="145" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d2Lg2" value="Có xoá mềm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="d2Legend">
          <mxGeometry x="170" y="40" width="145" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d2Lg3" value="Không có xoá mềm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="d2Legend">
          <mxGeometry x="325" y="40" width="145" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d2Lg4" value="Nhóm kiểm duyệt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="d2Legend">
          <mxGeometry x="480" y="40" width="145" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d2Lg5" value="Mũi nhọn tam giác rỗng = quan hệ KẾ THỪA (bảng con dùng chung khoá chính với bảng cha)&#10;Chân chẻ ba = phía &quot;nhiều&quot; của quan hệ khoá ngoại · Chữ màu đỏ trong hộp = rủi ro xác nhận từ mã nguồn" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="d2Legend">
          <mxGeometry x="15" y="78" width="610" height="36" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
