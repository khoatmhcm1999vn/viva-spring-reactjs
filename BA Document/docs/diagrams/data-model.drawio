        </mxCell>
        <mxCell id="d2s3" value="Thông báo khi có bình luận&#10;Mặc định: BẬT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="d2Settings">
