          </mxGeometry>
        </mxCell>
        <mxCell id="q2m6" value="6. Trả bình luận vừa tạo (HTTP 200) — KHÔNG chờ bước 7 trở đi" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="q2L3" target="q2L2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="620" y="425" as="sourcePoint" />
            <mxPoint x="380" y="425" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q2m7" value="7. Xác định người nhận: chủ bài đăng, chủ bình luận cha,&#10;và những người đã bình luận cùng bài&#10;(nếu A tự bình luận bài của mình thì KHÔNG sinh thông báo nào)" style="html=1;align=left;spacingLeft=6;endArrow=block;edgeStyle=orthogonalEdgeStyle;curved=0;strokeWidth=2;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="460" as="sourcePoint" />
            <mxPoint x="860" y="515" as="targetPoint" />
            <Array as="points">
              <mxPoint x="920" y="460" />
              <mxPoint x="920" y="515" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="q2m8" value="8. Đọc thiết lập của từng người nhận" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="q2L4" target="q2L5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="550" as="sourcePoint" />
            <mxPoint x="1100" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q2m9" value="9. Trả giá trị thiết lập nhận thông báo bình luận" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="q2L5" target="q2L4">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="595" as="sourcePoint" />
            <mxPoint x="860" y="595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q2m10" value="10. Nếu người nhận đã tắt thì bỏ qua.&#10;Một người nhận chỉ giữ MỘT thông báo&#10;có mức ưu tiên cao nhất." style="html=1;align=left;spacingLeft=6;endArrow=block;edgeStyle=orthogonalEdgeStyle;curved=0;strokeWidth=2;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="630" as="sourcePoint" />
            <mxPoint x="860" y="685" as="targetPoint" />
            <Array as="points">
              <mxPoint x="920" y="630" />
              <mxPoint x="920" y="685" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="q2m11" value="11. Lưu thông báo" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="q2L4" target="q2L5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="720" as="sourcePoint" />
            <mxPoint x="1100" y="720" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q2m12" value="12. Đẩy tới đích riêng của người nhận" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="q2L4" target="q2L6">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="765" as="sourcePoint" />
            <mxPoint x="1340" y="765" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q2m13" value="13. Thông báo thời gian thực qua kết nối đang mở" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="q2L6" target="q2L7">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1340" y="810" as="sourcePoint" />
            <mxPoint x="1580" y="810" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q2m14" value="14. Hiện chuông thông báo, không cần tải lại trang" style="html=1;align=left;spacingLeft=6;endArrow=block;edgeStyle=orthogonalEdgeStyle;curved=0;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="845" as="sourcePoint" />
            <mxPoint x="1580" y="885" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1640" y="845" />
              <mxPoint x="1640" y="885" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="q2n1" value="&lt;b&gt;Điều kiện bắt buộc để bước 13 chạy được&lt;/b&gt;&lt;br&gt;&lt;br&gt;Giao diện của B phải đã mở sẵn kết nối WebSocket, và kết nối đó chỉ mở được khi:&lt;br&gt;&lt;br&gt;• origin của trang nằm trong danh sách origin được phép của backend;&lt;br&gt;• lớp chuyển tiếp giữ nguyên header nâng cấp giao thức;&lt;br&gt;• phiếu xác thực được gửi trong header riêng của giao thức nhắn tin, không phải header HTTP thông thường.&lt;br&gt;&lt;br&gt;&lt;b&gt;Kiểu lỗi đặc trưng:&lt;/b&gt; nếu một trong ba điều trên sai, trang vẫn tải bình thường và API vẫn chạy — chỉ riêng chat và thông báo im lặng không hoạt động." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1700" y="180" width="180" height="330" as="geometry" />
        </mxCell>
        <mxCell id="q2n2" value="&lt;b&gt;Lưu ý về độ sâu bình luận&lt;/b&gt;&lt;br&gt;API đọc chỉ hỗ trợ hai cấp: bình luận cấp một và bình luận con của nó. Tuy nhiên tầng ghi KHÔNG chặn cấp ba — bước 3 chỉ kiểm tra bình luận cha thuộc đúng bài đăng. Một bình luận cấp ba tạo được nhưng sẽ không hiển thị ở đâu." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1700" y="530" width="180" height="210" as="geometry" />
        </mxCell>

        <mxCell id="q2Note" value="&lt;b&gt;VÌ SAO TRÌNH TỰ NÀY QUAN TRỌNG VỚI KIẾN TRÚC&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bước 6 trả kết quả cho người bình luận &lt;b&gt;trước&lt;/b&gt; khi chuỗi thông báo ở bước 7–13 hoàn tất. Đó là lựa chọn thiết kế có chủ ý: người bình luận không phải chờ hệ thống đi tính toán danh sách người nhận và đọc thiết lập của từng người.&lt;br&gt;&lt;br&gt;Hệ quả phải chấp nhận: &lt;b&gt;không có bảo đảm nào về thời điểm&lt;/b&gt; thông báo tới được người nhận, và nếu một bộ xử lý bất đồng bộ lỗi thì API vẫn báo thành công. Không có cơ chế thử lại.&lt;br&gt;&lt;br&gt;Kênh WebSocket ở bước 12–13 là lý do backend bắt buộc phải có endpoint công khai riêng: nền tảng phục vụ tệp tĩnh không giữ được kết nối dài, nên không thể chuyển tiếp chặng này." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#666666;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="940" width="800" height="230" as="geometry" />
        </mxCell>

        <mxCell id="q2Chan" value="&lt;b&gt;BẢNG: HÀNH ĐỘNG NÀO SINH THÔNG BÁO, GỬI QUA KÊNH NÀO&lt;/b&gt;" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="940" width="980" height="300" as="geometry" />
        </mxCell>
