        <mxCell id="q2m1" value="1. Nhập nội dung bình luận (tối đa 1200 ký tự)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="q2L1" target="q2L2">
