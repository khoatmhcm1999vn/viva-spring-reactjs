        <mxCell id="q2m2" value="2. POST /api/v1/comment  (nội dung, mã bài đăng, mã bình luận cha nếu có)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="q2L2" target="q2L3">
