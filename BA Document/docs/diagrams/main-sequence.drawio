        </mxCell>
        <mxCell id="q1m2" value="2. Gửi ảnh đi sàng lọc nội dung" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#b85450;fontSize=11;" edge="1" parent="1" source="q1L2" target="q1L3">
