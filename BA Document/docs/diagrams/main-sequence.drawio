          <mxGeometry x="255" y="150" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="q2c12" value="Nhận thông báo khi có người theo dõi (mặc định BẬT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="q2Chan">
