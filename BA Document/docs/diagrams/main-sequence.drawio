        <mxCell id="q1Title" value="TRÌNH TỰ TƯƠNG TÁC — ĐĂNG MỘT BÀI VIẾT KÈM ẢNH&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Nghiệp vụ trung tâm của hệ thống. Thứ tự và tên endpoint đều lấy từ mã nguồn.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
