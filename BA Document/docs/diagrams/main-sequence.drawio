        <mxCell id="q2c9" value="Nhận thông báo khi có người thích (mặc định BẬT) — các lượt thích được GỘP vào một thông báo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="q2Chan">
