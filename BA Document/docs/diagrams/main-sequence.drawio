        </mxCell>
        <mxCell id="q1m5" value="5. Kiểm tra phần mở rộng (png, jpeg, jpg, svg, gif)&#10;và giới hạn kích thước 10 MB" style="html=1;align=left;spacingLeft=6;endArrow=block;edgeStyle=orthogonalEdgeStyle;curved=0;strokeWidth=2;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;" edge="1" parent="1">
