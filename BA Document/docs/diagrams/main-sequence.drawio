        <mxCell id="q1m7" value="7. Trả về đường dẫn ảnh" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="q1L4" target="q1L5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="475" as="sourcePoint" />
            <mxPoint x="1100" y="475" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q1m8" value="8. Trả danh sách đường dẫn ảnh" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="q1L5" target="q1L2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="520" as="sourcePoint" />
            <mxPoint x="380" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q1m9" value="9. POST /api/v1/post  (chú thích + danh sách ảnh + mức riêng tư)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="q1L2" target="q1L5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="570" as="sourcePoint" />
            <mxPoint x="1100" y="570" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q1m10" value="10. Kiểm tra: chú thích tối đa 1500 ký tự,&#10;danh sách ảnh không được rỗng" style="html=1;align=left;spacingLeft=6;endArrow=block;edgeStyle=orthogonalEdgeStyle;curved=0;strokeWidth=2;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="600" as="sourcePoint" />
            <mxPoint x="1100" y="645" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1160" y="600" />
              <mxPoint x="1160" y="645" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="q1m11" value="11. Lưu bài đăng: chủ sở hữu = người tạo, active = true" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="q1L5" target="q1L7">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="675" as="sourcePoint" />
            <mxPoint x="1580" y="675" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q1m12" value="12. Xác nhận đã ghi" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="q1L7" target="q1L5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="715" as="sourcePoint" />
            <mxPoint x="1100" y="715" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q1m13" value="13. Phát sự kiện tạo bài đăng" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#d6b656;fontSize=11;" edge="1" parent="1" source="q1L5" target="q1L6">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="760" as="sourcePoint" />
            <mxPoint x="1340" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q1m14" value="14. Trả về bài đăng vừa tạo (HTTP 200)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="q1L5" target="q1L2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="805" as="sourcePoint" />
            <mxPoint x="380" y="805" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q1m15" value="15. Hiển thị bài đăng trên hồ sơ" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="q1L2" target="q1L1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="850" as="sourcePoint" />
            <mxPoint x="140" y="850" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q1m16" value="16. Trích hashtag từ chú thích, lưu hashtag mới và liên kết với bài đăng" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#d6b656;fontSize=11;" edge="1" parent="1" source="q1L6" target="q1L7">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1340" y="900" as="sourcePoint" />
            <mxPoint x="1580" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="q1n1" value="&lt;b&gt;Chốt kiểm duyệt ảnh nằm ở phía trình duyệt&lt;/b&gt;&lt;br&gt;Bước 2 và 3 là bước sàng lọc nội dung duy nhất, và nó chạy trong trình duyệt. Backend không kiểm duyệt lại nội dung ảnh, nên một client tự viết có thể bỏ qua hoàn toàn bước này." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1700" y="200" width="180" height="150" as="geometry" />
        </mxCell>
        <mxCell id="q1n2" value="&lt;b&gt;Chỉ API dạng nhiều ảnh kiểm tra định dạng&lt;/b&gt;&lt;br&gt;Endpoint tải một ảnh đơn lẻ KHÔNG kiểm tra phần mở rộng tệp. Đây là điểm cần thống nhất lại." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1700" y="370" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="q1n3" value="&lt;b&gt;Bước 16 chạy SAU khi API đã trả kết quả&lt;/b&gt;&lt;br&gt;Việc trích hashtag là bất đồng bộ. Hệ quả nghiệp vụ: một bài vừa đăng có thể chưa tìm được qua hashtag ngay lập tức.&lt;br&gt;&lt;br&gt;Ngoài ra tên hashtag được lưu &lt;b&gt;kèm dấu thăng&lt;/b&gt;, và biểu thức trích xuất không nhận ký tự tiếng Việt có dấu." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1700" y="740" width="180" height="210" as="geometry" />
        </mxCell>

        <mxCell id="q1Legend" value="CHÚ GIẢI" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="1000" width="1820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="q1Lg1" value="Đường LIỀN có mũi nhọn đặc = lời gọi đồng bộ, bên gọi chờ kết quả&#10;Đường NÉT ĐỨT có mũi hở = phản hồi trả về&#10;Vòng lặp về chính mình = xử lý nội bộ, không ra khỏi thành phần" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="q1Legend">
          <mxGeometry x="20" y="40" width="580" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q1Lg2" value="Màu đường nối cho biết thành phần nhận:&#10;tím = backend · xanh lá = cơ sở dữ liệu · cam = lưu trữ ảnh&#10;vàng = bus sự kiện · đỏ = dịch vụ gọi từ trình duyệt" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="q1Legend">
          <mxGeometry x="620" y="40" width="580" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q1Lg3" value="Khung ghi chú màu VÀNG = điểm cần làm rõ với bên nghiệp vụ&#10;Khung ghi chú màu ĐỎ = rủi ro đã xác nhận trong mã nguồn" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="q1Legend">
          <mxGeometry x="1220" y="40" width="580" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

