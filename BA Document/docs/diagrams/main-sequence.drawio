              <mxPoint x="1160" y="355" />
              <mxPoint x="1160" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="q1m6" value="6. Tải ảnh lên nơi lưu trữ" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="q1L5" target="q1L4">
