        <mxCell id="q1m1" value="1. Chọn ảnh, nhập chú thích, chọn mức riêng tư" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="q1L1" target="q1L2">
