        <mxCell id="q2c15" value="Nhận email kết quả xử lý báo cáo (mặc định BẬT) — gửi 2 thông báo: người tố cáo và người bị xử lý" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="q2Chan">
