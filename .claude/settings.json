{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose -f *)",
      "Bash(docker build *)",
      "Bash(docker push *)",
      "Bash(docker save *)",
      "Bash(docker load *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(brew install *)",
      "Bash(psql *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(vercel *)",
      "Bash(cloudflared *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./config/**)",
      "Read(./.kiro/settings/mcp.json)"
    ]
  }
}
