# Khong commit .env that. File nay chi liet ke TEN bien, khong chua gia tri.
# Copy thanh apps/api/.env khi chay local.

# development | test | production
NODE_ENV=development

# API chay o 3001 o dev; web chay o 3000.
PORT=3001

# Allowlist CORS, phan tach bang dau phay. Khong duoc dung "*" vi API nhan
# Authorization header. API se bao loi khi khoi dong neu gap "*".
CORS_ORIGINS=http://localhost:3000

# Postgres. Bo trong o buoc 03: /v1/health van chay, /v1/ready tra 503 NOT_READY.
# Duoc dung tu buoc 04 khi co Prisma.
DATABASE_URL=

# --- Xac thuc Supabase (bước 05) ---
# Chi doc o phia server, khong bao gio dat vao NEXT_PUBLIC_.
#
# Cach 1 (khuyen nghi, token ES256/RS256 moi): dat SUPABASE_URL. API lay public
# key tu <SUPABASE_URL>/auth/v1/.well-known/jwks.json de xac minh chu ky.
# Issuer mac dinh suy ra = <SUPABASE_URL>/auth/v1 (ghi de bang SUPABASE_JWT_ISSUER).
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
#
# Cach 2 (token HS256 legacy): dat SUPABASE_JWT_SECRET (JWT secret cua project).
# Chi dung khi khong the dung JWKS. API xac minh bang secret nay.
SUPABASE_JWT_SECRET=
#
# Khi ca SUPABASE_URL va SUPABASE_JWT_SECRET deu rong -> auth CHUA cau hinh:
# moi route bao ve tra 401. Catalog/health van cong khai.
#
# Server-only key neu can Storage admin; chon ten theo SDK/docs thuc te o buoc 06.
SUPABASE_SECRET_KEY=

# Ghi vao /v1/health de doi chieu ban deploy. Khong bat buoc.
APP_VERSION=0.1.0
