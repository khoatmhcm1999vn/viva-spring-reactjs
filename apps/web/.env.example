# Khong commit .env that. File nay chi liet ke TEN bien, khong chua gia tri.
# Copy thanh apps/web/.env.local khi chay local.
#
# CANH BAO: moi bien co tien to NEXT_PUBLIC_ deu di ra bundle client va
# nguoi dung doc duoc. Tuyet doi khong dat DATABASE_URL, service-role key
# hay bat ky secret nao vao NEXT_PUBLIC_.

# Base URL cua API NestJS, bao gom tien to /v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1

# Supabase client phia browser. Publishable/anon key la key cong khai theo thiet ke;
# dung o buoc 05. Khong dat secret key vao day.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
