# Copy sang .env roi dien gia tri that. File .env khong duoc commit.
#
#   cp .env.example .env
#
# docker-compose.yml khai bao DB_PASSWORD dang ${DB_PASSWORD:?...} nen thieu no
# la "docker compose up" dung ngay, chu khong khoi dong nua voi.

# --- Database (docker-compose doc) ---
POSTGRES_DB=coffeeshop
POSTGRES_USER=postgres
DB_PASSWORD=
DB_PORT=5434

# --- Server Express doc (xem server/src/db.js) ---
# Tach thanh bien roi thay vi mot URI: password chua @ : / ? # thi khong phai
# url-encode gi ca.
PGHOST=localhost
PGPORT=5434
PGDATABASE=coffeeshop
PGUSER=postgres
PGPASSWORD=
PORT=4000

# Origin cua client duoc phep goi API. De trong thi CORS tu choi het.
# Luc dev khong can den no vi Vite proxy /api (xem client/vite.config.js).
CORS_ORIGIN=http://localhost:5173
